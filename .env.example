# API NestJS del Edge Gateway (ej: http://192.168.40.10:3000/api)
VITE_BASE_URL=
# RUT956 Configuration
VITE_RUT956_DEFAULT_IP=
VITE_RUT956_DEFAULT_PORT=
# Observability — compartido por Sentry y Faro, ver src/services/observability/
# VITE_APP_VERSION se calcula automáticamente en vite.config.ts (git describe --tags), no setear acá.
VITE_OBSERVABILITY_ENVIRONMENT=local
# Observability (Sentry)
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
# Observability (Grafana Faro) — implementado pero desactivado por defecto.
# Ver docs/02-technical/06-observabilidad.md.
VITE_FARO_URL=
VITE_FARO_ENABLED=false

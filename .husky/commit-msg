#!/usr/bin/env sh
# Commit message validation
commit_msg=$(cat "$1")
# Check if commit message is not empty
if [ -z "$commit_msg" ]; then
  echo "❌ Commit message cannot be empty"
  exit 1
fi
# Check if commit message starts with a conventional commit type
if ! echo "$commit_msg" | grep -qE "^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert|merge)(\(.+\))?: .+"; then
  echo "❌ Commit message should follow conventional commits format:"
  echo "   <type>(<scope>): <description>"
  echo "   Examples:"
  echo "   - feat: add new feature"
  echo "   - fix(auth): resolve login issue"
  echo "   - docs: update README"
  echo "   - style: format code"
  echo "   - refactor: improve code structure"
  echo "   - test: add unit tests"
  echo "   - chore: update dependencies"
  echo "   - merge: merge branch 'feat/xyz-123' into 'main'"
  exit 1
fi
echo "✅ Commit message format is valid 🚀\n"